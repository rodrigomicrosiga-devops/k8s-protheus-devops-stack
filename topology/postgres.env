# Superusuário/banco de BOOTSTRAP do entrypoint oficial: precisam ser os defaults
# (postgres/postgres), NUNCA protheus. O init da imagem (init-protheus.sh) cria o
# usuário DB_USER e o banco DB_NAME com ENCODING WIN1252 -- exigência do Protheus --
# mas só se o banco ainda NÃO existir. Com POSTGRES_DB=protheus o entrypoint oficial
# o criava antes, em UTF8, e o init pulava a criação (achado de 2026-09-19, ADR 0015).
# É o mesmo que o Compose já faz (POSTGRES_DB=postgres).
POSTGRES_DB=postgres
POSTGRES_USER=postgres
# Adicionamos as chaves que o script do DbAccess e do repositório antigo validam:
DB_TYPE=POSTGRES
DB_DATABASE=protheus
DB_USER=protheus
# init-protheus.sh (docker-postgres-protheus) espera especificamente DB_NAME:
DB_NAME=protheus