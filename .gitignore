# Segredo real: nunca vai puro pro git (usar SealedSecret, ver base/postgres-secret.sealed.yaml).
# A cópia em texto puro só existe efemeramente no disco quando decriptada via
# scripts/secrets/decrypt.sh -- o backup de verdade é base/postgres-secret.env.gpg (versionado,
# ver docs/adr/0011-cofre-local-gpg-secrets-plaintext.md).
base/postgres-secret.env

# Mesma trava -- artefatos de bootstrap com credencial/chave real em texto plano.
# Backup de verdade fica no .gpg correspondente (versionado).
scripts/cluster-bootstrap/sealed-secrets-keys-backup.yaml
scripts/cluster-bootstrap/helm-values/*.yaml
!scripts/cluster-bootstrap/helm-values/argocd.yaml
!scripts/cluster-bootstrap/helm-values/argocd-image-updater.yaml
!scripts/cluster-bootstrap/helm-values/falco.yaml
!scripts/cluster-bootstrap/helm-values/sealed-secrets.yaml
!scripts/cluster-bootstrap/helm-values/minio-persistence.yaml
!scripts/cluster-bootstrap/helm-values/velero-overrides.yaml

# Binario compilado do cliente Go do SIGAACD -- gerado localmente via
# `go build`, nunca versionado (só o código-fonte).
scripts/sigaacd-client/go/sigaacd-client
